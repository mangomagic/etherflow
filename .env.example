# Copy to .env and fill in. Free key from https://etherscan.io/myapikey (email signup, no payment).
# A new key can take a few minutes to activate before it stops returning "Invalid API Key".
ETHERSCAN_API_KEY=YourApiKeyToken

# Optional overrides
# Etherscan API V2 base (the legacy V1 /api endpoint is deprecated).
# ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# ETHERSCAN_CHAIN_ID=1          # 1 = Ethereum mainnet
# FLASK_DEBUG=1
